# Container-side env. Fed into mbsync + suchi via env_file. Populated
# by ./setup.sh; this file is a reference — the real config/.env is
# gitignored.

# --- mbsync IMAP endpoint (values used by the mbsyncrc template) ---
# Proton:   MAIL_HOST=protonmail-bridge MAIL_PORT=143 MAIL_SSL=None
# Gmail:    MAIL_HOST=imap.gmail.com    MAIL_PORT=993 MAIL_SSL=IMAPS
# Fastmail: MAIL_HOST=imap.fastmail.com MAIL_PORT=993 MAIL_SSL=IMAPS
MAIL_HOST=protonmail-bridge
MAIL_PORT=143
MAIL_SSL=None
MAIL_USER=you@example.com
MAIL_PASSWORD=change-me
MAIL_FOLDERS="INBOX"
MAIL_MAX_MESSAGES=200
MAIL_MAX_SIZE=25m
SYNC_INTERVAL=300

# --- suchi runtime ---
# Env-var names here are the ones suchi's config.go reads directly.
PUBLIC_URL=http://127.0.0.1:8000
LISTEN_ADDR=:8000
DATA_DIR=/data
INGEST_FS_DIR=/ingest
INGEST_FS_OWNER_EMAIL=you@example.com
LOG_LEVEL=info
