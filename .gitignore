# build artifacts
/dist/
/bin/
*.exe
*.test
*.out
*.prof

# local dev data
/data/
/tmp/
*.db
*.db-wal
*.db-shm
.session-key

# editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# secrets — belt and suspenders
*.pem
*.key
.env
.env.*
!.env.example
!.env.sample

# stray binary from ad-hoc `go build` calls
/distro/suchi
.decrypt-key

# svelte SPA build tree
ui/node_modules/
ui/dist/

# But DO commit the embedded dist — it ships in the binary and a fresh
# clone must `go build` without Node installed. Whitelist beats the
# global .gitignore's `dist/` rule that would otherwise trap this.
!core/ui/spa/dist/
!core/ui/spa/dist/**

# Override the common global-gitignore `lib/` rule (matches Rust /lib,
# Python installs, etc.) so ui/src/lib/* stays trackable from any dev's
# machine. Without this, `git add ui/src/lib/api.js` silently no-ops on
# hosts that carry the pattern in ~/.gitignore_global.
!ui/src/lib/
!ui/src/lib/**

# Maintainer scratchpad (personal backlog; not shipped)
/tasks.md
