{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Suchi",
  "version": "0.3.0",
  "identifier": "xyz.johnnybravo.suchi",
  "build": {
    "beforeDevCommand": {
      "script": "bun scripts/serve-launcher.js",
      "cwd": "..",
      "wait": false
    },
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../launcher"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": ["launcher"],
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 Ritesh Shrivastav",
    "homepage": "https://suchi.page",
    "shortDescription": "Local document archive",
    "longDescription": "Capture, file, retrieve, and review documents in a private local archive.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/suchi-sidecar"],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE",
      "../THIRD-PARTY-NOTICES.html": "THIRD-PARTY-NOTICES.html"
    },
    "targets": "all"
  }
}
