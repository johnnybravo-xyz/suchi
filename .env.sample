# suchi — env-var sample
#
# Every knob has a matching TOML/YAML/HUML field of the same name in
# lowercase (see docs/config.example.toml). Env vars OVERRIDE file
# config; DB settings written from the SPA override env at boot.
#
# To use: copy to `.env`, edit, then `source .env` (or point systemd/
# compose EnvironmentFile= at it). The `.env` file itself is
# gitignored — never commit real secrets.

# --------------------------------------------------------------------
# Required
# --------------------------------------------------------------------

# The absolute URL clients hit — cookie domain, OIDC callbacks, share
# links all key off this.
PUBLIC_URL=http://127.0.0.1:8000

# --------------------------------------------------------------------
# Storage & runtime
# --------------------------------------------------------------------

DATA_DIR=/data
LISTEN_ADDR=:8000
LOG_LEVEL=info
BODY_LIMIT=100M

# Optional — override the session-key path (default: $DATA_DIR/.session-key)
#SESSION_KEY_PATH=/etc/suchi/session-key

# --------------------------------------------------------------------
# Backups + audit retention
# --------------------------------------------------------------------

BACKUP_INTERVAL=24h
BACKUP_KEEP=7
AUDIT_RETENTION_DAYS=20

# --------------------------------------------------------------------
# UI toggle
# --------------------------------------------------------------------

# Set to 1 or true to skip all browser-facing routes at boot.
#SUCHI_UI_DISABLED=

# --------------------------------------------------------------------
# TLS (only when suchi terminates TLS itself, not behind a proxy)
# --------------------------------------------------------------------

#TLS_CERT_FILE=/etc/suchi/cert.pem
#TLS_KEY_FILE=/etc/suchi/key.pem

# --------------------------------------------------------------------
# OCR + ingest limits
# --------------------------------------------------------------------

OCR_LANGUAGES=eng
OCR_ENGINE=auto
PDF_MAX_CONTENT_BYTES=8M
EPUB_MAX_CONTENT_BYTES=32M
DJVU_MAX_CONTENT_BYTES=32M

# --------------------------------------------------------------------
# Scan pre-processing
# --------------------------------------------------------------------

#SCAN_BLANK_REMOVAL=true
#SCAN_BLANK_WHITENESS_THRESHOLD=99
#SCAN_SPLIT_ENABLED=false
#SCAN_SPLIT_TOKEN=SUCHI-SPLIT
#SCAN_SPLIT_DPI=300

# --------------------------------------------------------------------
# Pre-consume script — absolute path only
# --------------------------------------------------------------------

#PRE_CONSUME_SCRIPT=/etc/suchi/pre-consume.sh

# --------------------------------------------------------------------
# PDF auto-decrypt password pool
# --------------------------------------------------------------------

#INGEST_PASSWORDS_FILE=/etc/suchi/decrypt-passwords.txt

# --------------------------------------------------------------------
# OIDC (all-or-nothing; empty ISSUER_URL disables OIDC entirely)
# --------------------------------------------------------------------

#OIDC_ISSUER_URL=https://id.example.com
#OIDC_CLIENT_ID=suchi
#OIDC_CLIENT_SECRET=
#OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc-client-secret
#ADMIN_EMAIL=you@example.com

# --------------------------------------------------------------------
# Filesystem-watch ingest
# --------------------------------------------------------------------

#INGEST_FS_DIR=/data/staging
#INGEST_FS_OWNER_EMAIL=you@example.com

# --------------------------------------------------------------------
# Email ingest (IMAP polling) — in-process poller
# --------------------------------------------------------------------
#
# The SPA Admin panel can also write these into DB settings; settings
# override env at boot.

#INGEST_IMAP_URL=imaps://you@mail.example.com/INBOX
#INGEST_IMAP_PASSWORD=
#INGEST_IMAP_OWNER_EMAIL=you@example.com

# --------------------------------------------------------------------
# Mail-mbsync sidecar (separate compose bundle — not the poller above)
# --------------------------------------------------------------------

#MAIL_SETUP_ENV_PATH=/etc/suchi/mail-config/.env
#MAIL_SETUP_CONTAINER=suchi-mail-mbsync
#MAIL_SETUP_DOCKER_SOCK=/var/run/docker.sock

# --------------------------------------------------------------------
# LLM classifier (opt-in)
# --------------------------------------------------------------------

#LLM_ENDPOINT_URL=http://127.0.0.1:11434/v1
#LLM_MODEL=llama3.1:8b
#LLM_API_KEY=
#LLM_EGRESS_ACK=true
